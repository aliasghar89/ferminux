<?xml version="1.0" encoding="utf-8"?>
<!-- Shipped build: HTTPS only, system CAs only (no user-installed CAs can intercept wallet traffic). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
