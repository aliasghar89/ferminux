<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Black canvas everywhere: no white flash before the page paints. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/fxw_black</item>
        <item name="colorPrimaryDark">@color/fxw_black</item>
        <item name="colorAccent">@color/fxw_green</item>
        <item name="android:windowBackground">@color/fxw_black</item>
        <item name="android:statusBarColor">@color/fxw_black</item>
        <item name="android:navigationBarColor">@color/fxw_black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!-- Android 12+ system splash: the mark on black, then the app theme. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fxw_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
