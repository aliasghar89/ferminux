{
  "name": "ferminux-wallet-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Official self-hosted Ferminux web wallet (FMX, chain 3961, plus seven other networks and WalletConnect)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.mjs\"",
    "e2e": "node scripts/e2e.mjs",
    "live": "node scripts/live-activity.mjs",
    "ui": "node scripts/ui-check.mjs",
    "smoke": "node scripts/multichain-smoke.mjs",
    "mint-smoke": "node scripts/mint-smoke.mjs"
  },
  "dependencies": {
    "@capacitor-community/privacy-screen": "^8.0.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/barcode-scanner": "^3.1.2",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-native-biometric": "^8.6.11",
    "@reown/walletkit": "^1.6.0",
    "@walletconnect/core": "^2.25.0",
    "@walletconnect/utils": "^2.25.0",
    "ethers": "^6.13.4",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "vite": "^6.3.5"
  }
}
