# Build-time overrides (Vite). Copy to .env and edit, or export in the shell.
# Defaults (src/config.ts) already point at Ferminux mainnet.

# TokenFactory registry address on chain 3961
VITE_FACTORY_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# JSON-RPC endpoint used for read-only queries (list + fee work without a wallet)
VITE_RPC_URL=https://rpc.ferminux.net

# Block-explorer base URL for outbound links
VITE_EXPLORER_URL=https://explorer.ferminux.net
