# Build-time overrides (Vite). Copy to .env and edit, or export in the shell.
# Defaults (src/config.ts) already point at Ferminux mainnet.

# TokenFactory registry address on chain 3961: the live TokenFactory v1.
# Leave unset for production (src/config.ts has the same default).
VITE_FACTORY_ADDRESS=0x62BC7d9671EfE1385413434aB8fdfE2fa4aE01D4

# JSON-RPC endpoints for read-only queries (list + fee work without a wallet),
# comma-separated, in order of preference
VITE_RPC_URLS=https://rpc.ferminux.net,https://ferminux.net/rpc

# WalletConnect (Reown) project id; unset = no WalletConnect choice.
# Production: ../.credentials/walletconnect.env
# VITE_WC_PROJECT_ID=

# Block-explorer base URL for outbound links
VITE_EXPLORER_URL=https://explorer.ferminux.net
