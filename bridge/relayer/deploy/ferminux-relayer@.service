# Ferminux Bridge relayer — templated systemd unit.
#
#   systemctl enable --now ferminux-relayer@validator
#   systemctl enable --now ferminux-relayer@submitter
#
# %i is the role. In a real M-of-N deployment the validator instances live on
# THREE SEPARATE MACHINES under three separate custodians; running two validator
# keys on one host makes the threshold decorative.
#
# Install (as root):
#   useradd --system --home /var/lib/ferminux-relayer --shell /usr/sbin/nologin ferminux-relayer
#   install -d -o ferminux-relayer -g ferminux-relayer -m 0750 /var/lib/ferminux-relayer
#   install -d -o root -g ferminux-relayer -m 0750 /etc/ferminux-relayer
#   rsync -a --exclude node_modules --exclude state ./ /opt/ferminux-relayer/
#   (cd /opt/ferminux-relayer && npm ci --omit=dev)
#   cp config/chains.example.json /etc/ferminux-relayer/chains.json   # then edit it
#   install -o root -g ferminux-relayer -m 0640 validator.keystore.json /etc/ferminux-relayer/
#   install -o root -g ferminux-relayer -m 0640 validator.password     /etc/ferminux-relayer/
#   install -m 0644 deploy/ferminux-relayer@.service /etc/systemd/system/
#   systemctl daemon-reload

[Unit]
Description=Ferminux Bridge relayer (%i)
Documentation=file:/opt/ferminux-relayer/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=ferminux-relayer
Group=ferminux-relayer
WorkingDirectory=/opt/ferminux-relayer

# Key material is handed over as systemd credentials: root-owned on disk, copied
# into a per-unit tmpfs at 0400, never visible to any other service, and never in
# the environment or the process list. %d expands to that directory.
LoadCredential=keystore:/etc/ferminux-relayer/%i.keystore.json
LoadCredential=password:/etc/ferminux-relayer/%i.password
Environment=FMX_RELAYER_KEYSTORE=%d/keystore
Environment=FMX_RELAYER_PASSWORD_FILE=%d/password

Environment=NODE_ENV=production
Environment=FMX_RELAYER_CONFIG=/etc/ferminux-relayer/chains.json
Environment=FMX_RELAYER_STATE=/var/lib/ferminux-relayer/%i.db
Environment=FMX_RELAYER_LOG_FORMAT=json
# Anything else — alert webhook, API token, peer list, per-chain RPC overrides —
# goes here. Optional; the leading - means "do not fail if it is missing".
EnvironmentFile=-/etc/ferminux-relayer/%i.env

ExecStartPre=/usr/bin/node src/index.ts --role check --config /etc/ferminux-relayer/chains.json
ExecStart=/usr/bin/node src/index.ts --role %i --config /etc/ferminux-relayer/chains.json

# SIGTERM is a clean shutdown: timers stop, the HTTP server drains, the store is
# closed. Give it room rather than SIGKILLing mid-write.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ferminux-relayer-%i

# ---- hardening -------------------------------------------------------------
# This process holds a key that can authorise value. It should be able to do
# exactly two things: talk to RPC endpoints, and write its own state directory.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
# The ONLY writable path.
ReadWritePaths=/var/lib/ferminux-relayer
# NOTE: MemoryDenyWriteExecute is deliberately NOT set — V8's JIT needs W+X and
# the unit will fail to start with it on.
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
