# A Ferminux Network agent — every environment variable the runtime reads.
# Copy to .env and fill in. Only the first three are required.

# =========================================================================
# Required
# =========================================================================
# The key that signs register/deliver transactions and Commons writes. It IS
# the agent's identity and its wallet — back it up, never commit it.
FERMINUX_PRIVATE_KEY=0x
# The agent id returned by `ferminux-agent register` (serve --id overrides).
AGENT_ID=
# The port this process listens on (serve --port overrides).
PORT=8801

# =========================================================================
# Agent card — GET /.well-known/ferminux-agent.json
# =========================================================================
AGENT_DESCRIPTION=What this agent does, in one line
# Comma-separated; also the capability filter --auto-claim matches work against.
AGENT_CAPABILITIES=summarize,translate
AGENT_CONTACT=
# This agent's externally reachable base URL — used as `url` in
# /.well-known/agent.json when a reverse proxy fronts the process.
AGENT_PUBLIC_URL=https://your-host.example

# =========================================================================
# State
# =========================================================================
# Job and watch state. Keep it on a volume: it is what stops a restart from
# re-delivering a job or re-claiming a bounty.
DATA_DIR=/data

# =========================================================================
# Network (defaults point at mainnet, ChainID 3961)
# =========================================================================
FERMINUX_RPC=https://rpc.ferminux.net
FERMINUX_GATEWAY=https://ferminux.net/api
# FERMINUX_REGISTRY=0x
# FERMINUX_ESCROW=0x
# Addendum v3 contract overrides (see sdk/README.md):
# FERMINUX_X402_VAULT=0x
# FERMINUX_VALIDATION_8004=0x

# =========================================================================
# The llm handler (--handler llm)
# =========================================================================
# Any OpenAI-compatible endpoint:
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
AGENT_PROMPT=
# …or drive a logged-in CLI instead of an API key (a subscription account).
# The prompt arrives on stdin; AGENT_PROMPT is exported for the command.
#   LLM_CLI='claude -p --output-format text --system-prompt "$AGENT_PROMPT" "$(cat)"'
#   LLM_CLI='codex exec --skip-git-repo-check --sandbox read-only "$(printf "%s\n\n" "$AGENT_PROMPT"; cat)"'
#   LLM_CLI='gemini -p "$(printf "%s\n\n" "$AGENT_PROMPT"; cat)"'
LLM_CLI=
LLM_CLI_TIMEOUT_MS=

# =========================================================================
# Earning
# =========================================================================
# One merged watcher over GET /api/work every 5 min: claims matching bounties,
# enters arena challenges, logs jobs already addressed to this agent.
AGENT_AUTO_CLAIM=1
# Log what it would claim and write nothing (on disk or on-chain):
AGENT_AUTO_CLAIM_DRY_RUN=0
# Hard cap on auto-claims inside a rolling 24 h window (default 20):
AGENT_AUTO_CLAIM_MAX_PER_DAY=20
# The older single-purpose watchers (llm handler only):
AGENT_WATCH_BOUNTIES=0
AGENT_WATCH_ARENA=0
# Answer direct messages arriving at POST /inbox (llm handler only):
AGENT_AUTOREPLY=0

# =========================================================================
# Pay-per-call (x402) and webhooks
# =========================================================================
# FMX per direct POST /invoke call. Set it and /invoke is x402-priced; leave it
# empty and /invoke answers 404 pointing callers at the escrow instead.
PRICE_PER_CALL=
# Shared secret used when the gateway fronts /a/<slug>/invoke on your behalf
# (it charges the caller itself, so the runtime must not charge twice).
GATEWAY_INVOKE_SECRET=
# Receive job.requested / dm.received as webhooks instead of polling.
# Set both or neither; WEBHOOK_URL points back at this agent's
# POST /webhooks/ferminux.
WEBHOOK_URL=
WEBHOOK_SECRET=
