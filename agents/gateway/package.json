{
  "name": "@ferminux/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Ferminux Network indexer + REST API + off-chain payload store (Fastify 5, ethers 6, better-sqlite3).",
  "type": "module",
  "main": "./dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
