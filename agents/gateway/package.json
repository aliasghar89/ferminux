    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test test/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "better-sqlite3": "^12.11.1",
    "ethers": "^6.13.4",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  },
  "license": "MIT"
}
