# Copy to .env and adjust. Everything except the two secrets at the end has a
# working local default in docker-compose.yml; the secrets have none, and
# docker compose refuses to start until both are set.

# --- node URLs (as seen from inside the containers) ---
# Local devnet through colima/Docker Desktop:
#FMX_RPC_HTTP=http://host.docker.internal:8545
#FMX_RPC_WS=ws://host.docker.internal:8546
# Production: the dedicated non-sealing node on the fmxnet network (see
# docker-compose.prodnet.yml for why not rpc1/rpc2 or the public RPC):
#FMX_RPC_HTTP=http://fmxp-miner:8545
#FMX_RPC_WS=ws://fmxp-miner:8546

# --- public origin of the explorer (what the browser sees) ---
# Local:
#FMX_EXPLORER_HOST=localhost
#FMX_EXPLORER_PUBLIC_PORT=4000
#FMX_EXPLORER_PROTO=http
#FMX_EXPLORER_WS_PROTO=ws
# Production behind TLS. WS_PROTO=wss is MANDATORY here: an https page
# cannot open a ws:// socket (mixed content) and Blockscout's frontend
# then fails with "Oops! Something went wrong" on every page.
#FMX_EXPLORER_HOST=explorer.ferminux.net
#FMX_EXPLORER_PUBLIC_PORT=443
#FMX_EXPLORER_PROTO=https
#FMX_EXPLORER_WS_PROTO=wss

# --- listeners on this machine ---
#FMX_EXPLORER_PORT=4000       # nginx entrypoint (frontend + API)
#FMX_EXPLORER_DB_PORT=127.0.0.1:7432  # postgres, debug access (loopback; never publish it)

# --- secrets: REQUIRED, no defaults, never committed ---
# Left empty on purpose (an empty value counts as unset, so compose still
# refuses). Generate fresh values for every host, local smoke tests included:
#   sed -i "s|^POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=$(openssl rand -hex 24)|" .env
#   sed -i "s|^SECRET_KEY_BASE=.*|SECRET_KEY_BASE=$(openssl rand -base64 48)|" .env
# POSTGRES_PASSWORD goes into the backend's DATABASE_URL, so keep it hex.
POSTGRES_PASSWORD=
SECRET_KEY_BASE=

# --- "Add network to wallet" RPC URL shown by the frontend ---
#FMX_PUBLIC_RPC_URL=https://rpc.ferminux.net
