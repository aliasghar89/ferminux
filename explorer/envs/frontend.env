# Blockscout frontend — Ferminux Network (static config)
# Host/port/protocol of the public origin are injected by docker-compose.yml / k8s.

NEXT_PUBLIC_NETWORK_NAME=Ferminux Network
NEXT_PUBLIC_NETWORK_SHORT_NAME=Ferminux
NEXT_PUBLIC_NETWORK_ID=3961
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=Ferminux
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=FMX
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_IS_TESTNET=false
NEXT_PUBLIC_NETWORK_VERIFICATION_TYPE=mining

NEXT_PUBLIC_API_BASE_PATH=/
NEXT_PUBLIC_GAS_TRACKER_ENABLED=true

# self-hosted: no ads, no analytics, no external widgets
NEXT_PUBLIC_AD_BANNER_PROVIDER=none
NEXT_PUBLIC_AD_TEXT_PROVIDER=none

# no stats/visualizer microservices in this minimal stack
NEXT_PUBLIC_HOMEPAGE_CHARTS=[]

# --------------------------------------------------------------- branding
# These URLs are fetched BY THE CONTAINER at start, not by the browser:
# entrypoint.sh runs download_assets.sh, which curls each one (5s connect /
# 15s total) into /app/public/assets/configs/ and the page then references the
# LOCAL copy. So the URL must be absolute, reachable from inside the container,
# and its path must END IN A FILE EXTENSION — the extension is parsed out with
# a regex, and a URL without one leaves the logo silently undefined and renders
# stock Blockscout chrome instead. ferminux.net is reachable from the container
# (verified), and is the same origin that serves the public site, so the
# explorer and the site cannot drift onto different marks.
NEXT_PUBLIC_NETWORK_LOGO=https://ferminux.net/assets/brand/fmx-wordmark.svg
NEXT_PUBLIC_NETWORK_LOGO_DARK=https://ferminux.net/assets/brand/fmx-wordmark-dark.svg
NEXT_PUBLIC_NETWORK_ICON=https://ferminux.net/assets/brand/fmx-round.svg
NEXT_PUBLIC_NETWORK_ICON_DARK=https://ferminux.net/assets/brand/fmx-round.svg

# The public site is a light, near-white theme with one amber accent. Match it.
NEXT_PUBLIC_COLOR_THEME_DEFAULT=light

# Homepage plate. Arrays are [light, dark]. HOMEPAGE_PLATE_BACKGROUND and
# _TEXT_COLOR still work in v2.3.5 but print a deprecation warning and are
# removed next release, so this is the form to use.
NEXT_PUBLIC_HOMEPAGE_HERO_BANNER_CONFIG={"background":["#a8761c","#8a5f14"],"text_color":["#ffffff","#ffffff"]}

# Set this or the container POSTs to bigs.services.blockscout.com to generate a
# social preview — an external call this stack otherwise does not make. The code
# short-circuits on this var, so a self-hosted image skips the call entirely.
NEXT_PUBLIC_OG_IMAGE_URL=https://ferminux.net/assets/brand/fmx-og.png

# Blockscout appends "| Blockscout" to every page title and uses its own generic
# meta description unless these are set. Both are supported in v2.3.5
# (NEXT_PUBLIC_PROMOTE_BLOCKSCOUT_IN_TITLE, NEXT_PUBLIC_OG_DESCRIPTION); the
# footer keeps its open-source attribution either way, which is correct.
NEXT_PUBLIC_PROMOTE_BLOCKSCOUT_IN_TITLE=false
NEXT_PUBLIC_OG_DESCRIPTION=Block explorer for Ferminux Network (chain ID 3961). Search transactions, addresses, blocks and verified contracts.
