# Blockscout smart-contract-verifier (ghcr.io/blockscout/smart-contract-verifier:v1.10.7)
# Static config. Env names are the service's own (prefix SMART_CONTRACT_VERIFIER__, sections
# joined with __); defaults live in the image's config/base.toml.
#
# The backend reaches this service at http://smart-contract-verifier:8050 on the compose
# project network (see MICROSERVICE_SC_VERIFIER_URL in backend.env). No host port.

# --- server: HTTP only ---
SMART_CONTRACT_VERIFIER__SERVER__HTTP__ENABLED=true
SMART_CONTRACT_VERIFIER__SERVER__HTTP__ADDR=0.0.0.0:8050
# 2 MiB request cap. A standard-JSON input carries every source file of the build: the
# largest in this repo (bridge, via-IR) is well under 1 MiB.
SMART_CONTRACT_VERIFIER__SERVER__HTTP__MAX_BODY_SIZE=2097152
SMART_CONTRACT_VERIFIER__SERVER__GRPC__ENABLED=false

# --- Solidity ---
# Compilers are downloaded on first use from the official solc build list and kept in the
# verifier-compilers volume (mounted at /tmp, see docker-compose.yml), so a restart does not
# download them again. The image is linux/amd64, so it takes the linux-amd64 builds.
SMART_CONTRACT_VERIFIER__SOLIDITY__ENABLED=true
SMART_CONTRACT_VERIFIER__SOLIDITY__COMPILERS_DIR=/tmp/solidity-compilers
SMART_CONTRACT_VERIFIER__SOLIDITY__REFRESH_VERSIONS_SCHEDULE=0 0 * * * * *
SMART_CONTRACT_VERIFIER__SOLIDITY__FETCHER__LIST__LIST_URL=https://binaries.soliditylang.org/linux-amd64/list.json

# --- Vyper ---
# Kept on: the explorer is public and anyone may deploy a Vyper contract on chain 3961.
SMART_CONTRACT_VERIFIER__VYPER__ENABLED=true
SMART_CONTRACT_VERIFIER__VYPER__COMPILERS_DIR=/tmp/vyper-compilers
SMART_CONTRACT_VERIFIER__VYPER__REFRESH_VERSIONS_SCHEDULE=0 0 * * * * *
SMART_CONTRACT_VERIFIER__VYPER__FETCHER__LIST__LIST_URL=https://raw.githubusercontent.com/blockscout/solc-bin/main/vyper.list.json

# --- off: external services and telemetry ---
# Sourcify does not index chain 3961, and the backend has SOURCIFY_INTEGRATION_ENABLED=false.
SMART_CONTRACT_VERIFIER__SOURCIFY__ENABLED=false
SMART_CONTRACT_VERIFIER__ZKSYNC_SOLIDITY__ENABLED=false
SMART_CONTRACT_VERIFIER__METRICS__ENABLED=false
SMART_CONTRACT_VERIFIER__JAEGER__ENABLED=false

# One compile at a time. Verification is rare here, and a via-IR compile is the heaviest
# thing this container does; one at a time keeps it inside the memory cap in docker-compose.yml.
SMART_CONTRACT_VERIFIER__COMPILERS__MAX_THREADS=1
