# Blockscout backend — Ferminux Network (static config)
# RPC URLs, DATABASE_URL and SECRET_KEY_BASE are injected by docker-compose.yml / k8s.

# --- chain identity ---
CHAIN_ID=3961
COIN=FMX
COIN_NAME=FMX
NETWORK=Ferminux
SUBNETWORK=Ferminux Network
CHAIN_TYPE=default

# --- node ---
ETHEREUM_JSONRPC_VARIANT=geth
ETHEREUM_JSONRPC_TRANSPORT=http
# ferminux-geth (geth v1.10.26 fork): the public RPC does not expose debug/trace,
# so internal transactions and trace-based fetchers are off.
INDEXER_DISABLE_INTERNAL_TRANSACTIONS_FETCHER=true
# geth variant cannot fetch beneficiaries; the rewards sidecar covers miner rewards.
INDEXER_DISABLE_BLOCK_REWARD_FETCHER=true
# Historical state: every node on this network is pruned (--gcmode full), so an
# eth_getBalance / eth_getCode AT AN OLD BLOCK answers "missing trie node" for
# ever. Blockscout retries those without limit: in Sept 2026 15,222 historical
# address_coin_balances rows (blocks 1..266,652) and a stuck ContractCode queue
# kept the backend at ~2 cores and ~25k error lines/min. Recent blocks are
# fine (the node keeps the last 128 states), so the coin-balance fetchers stay
# ON for live balances; the unfetchable history is cleared in the DB instead
# (see the deploy runbook). If the loop comes back and no archive node exists,
# the switch below stops it, at the cost of address balances refreshing only
# on demand (when an address page is opened):
#INDEXER_DISABLE_ADDRESS_COIN_BALANCE_FETCHER=true

# Imports the genesis premine balances (geth-format spec, alloc section).
CHAIN_SPEC_PATH=/app/chainspec/genesis.json

# --- server ---
PORT=4000
ECTO_USE_SSL=false
POOL_SIZE=30
POOL_SIZE_API=10
API_V2_ENABLED=true
NETWORK_PATH=/
DISABLE_INDEXER=false
DISABLE_REALTIME_INDEXER=false

# --- network totals: how often the index recounts them ---
# /api/v2/stats total_transactions and total_addresses and /api/v2/transactions/stats
# transactions_count_24h are cached counters. Blockscout 9.0.2's defaults (config/runtime.exs) are 2 h,
# 30 min and 1 h, which made the explorer's totals look frozen. Each recount is one query on a timer,
# whatever the traffic, so 5 minutes costs little:
#   CACHE_TXS_COUNT_PERIOD                TransactionsCount: SELECT count(hash) FROM transactions, an
#                                         index-only scan of the primary key. ~25k rows today; a load test
#                                         at 20 tx/s adds ~1.7M a day: roughly a second per 10M rows, so a
#                                         test that runs for weeks is worth raising this to 15m.
#   CACHE_ADDRESS_COUNT_PERIOD            AddressesCount: SELECT count(*) FROM addresses (under 100k rows
#                                         even with every load-test wallet): milliseconds.
#   CACHE_TRANSACTIONS_24H_STATS_PERIOD   Transactions24hCount: count, fee sum and average fee of the
#                                         transactions of the last 24 h, a range scan of the
#                                         transactions(block_timestamp) index joined to blocks. Only the last
#                                         day is read: a few ms today, a second or two at a sustained 20 tx/s.
#                                         If a long high-rate load test makes that show in the backend's CPU,
#                                         raise this one to 15m.
# Not touched: transactions_today is the daily history row for YESTERDAY (Historian, once a day), and
# total_blocks (CACHE_BLOCK_COUNT_PERIOD) is not shown anywhere; the explorer reads the head from the RPC.
# Deploy: recreate the backend only (the index keeps its data; indexing resumes in a minute or so). The
# server's .env sets COMPOSE_FILE (docker-compose.yml + prodnet + spa overlays); without it the backend
# would lose the fmxnet network and its node, so check it first:
#   cd /opt/ferminux/explorer && grep '^COMPOSE_FILE=' .env && docker compose up -d --no-deps --force-recreate backend
# Check: curl -s https://explorer.ferminux.net/api/v2/stats | jq .total_transactions  (moves within 5 min)
CACHE_TXS_COUNT_PERIOD=5m
CACHE_ADDRESS_COUNT_PERIOD=5m
CACHE_TRANSACTIONS_24H_STATS_PERIOD=5m

# --- EIP-1559 (enabled from genesis, elasticity 2, initial base fee 1 gwei) ---
EIP_1559_ELASTICITY_MULTIPLIER=2

# --- contract verification: our own smart-contract-verifier (docker-compose.yml) ---
# Without it the backend has no compiler list (verification/config returns an empty
# solidity_compiler_versions) and no contract can be verified. TYPE sc_verifier = talk to
# the verifier directly; the other type, eth_bytecode_db, needs a separate database service.
# Leaving the URL unset would make Blockscout fall back to its hosted eth-bytecode-db.
MICROSERVICE_SC_VERIFIER_ENABLED=true
MICROSERVICE_SC_VERIFIER_URL=http://smart-contract-verifier:8050/
MICROSERVICE_SC_VERIFIER_TYPE=sc_verifier

# --- coin price, market cap and supply: read from the Ferminux gateway, not from a price service ---
# Blockscout 9.0.2 has no setting that states a coin supply. Its figures come from two places:
#   1. The market source (Explorer.Market.Source.*). /api/v2/stats coin_price, coin_image and market_cap,
#      /api/v2/stats/charts/market available_supply, /api/v2/addresses total_supply and
#      /api?module=stats&action=ethsupplyexchange all read the native coin's market record. With
#      DISABLE_EXCHANGE_RATES=true there is no record, hence coin_price null, market_cap "0" and a total
#      supply of 0.
#   2. /api?module=stats&action=coinsupply and action=ethsupply are the SUM OF INDEXED ADDRESS BALANCES
#      (AddressesCoinBalanceSum, no setting). On these pruned nodes that sum is incomplete (24.35M FMX on
#      2026-09-26, below the 30M genesis alone) and no env var changes it; point listing sites at
#      https://ferminux.net/api/supply/total and /api/supply/circulating instead.
# For (1), the CoinGecko source is pointed at the gateway, which serves FMX in CoinGecko's /coins/{id}
# response shape from its own numbers (agents/gateway/src/supply.ts): price from the Ferminux DEX pool,
# market cap = price x circulating supply, total/circulating/max supply computed on chain, the 256 px logo.
# Blockscout calls exactly <base>/coins/ferminux?localization=false&tickers=false&market_data=true&... every
# MARKET_COIN_CACHE_PERIOD. No request leaves for a third-party service: the history fetcher (which would
# default to CryptoCompare and DefiLlama) and the token-price fetcher stay off.
# Needs the gateway release that serves /api/market/coingecko (GET it before recreating the backend):
#   curl -s https://ferminux.net/api/market/coingecko/coins/ferminux | jq .market_data
# Check after the backend restart (the first fetch runs at start, then every 10 min):
#   curl -s https://explorer.ferminux.net/api/v2/stats | jq '{coin_price, coin_image, market_cap}'
#   curl -s 'https://explorer.ferminux.net/api?module=stats&action=ethsupplyexchange'   (total supply, wei)
# Rollback: DISABLE_EXCHANGE_RATES=true and recreate the backend.
DISABLE_EXCHANGE_RATES=false
MARKET_NATIVE_COIN_SOURCE=coin_gecko
MARKET_COINGECKO_BASE_URL=https://ferminux.net/api/market/coingecko
MARKET_COINGECKO_COIN_ID=ferminux
MARKET_COIN_FETCHER_ENABLED=true
MARKET_COIN_CACHE_PERIOD=10m
MARKET_HISTORY_FETCHER_ENABLED=false
MARKET_TOKENS_FETCHER_ENABLED=false

# --- self-hosted: no other external services, no telemetry ---
MICROSERVICE_ETH_BYTECODE_DB_ENABLED=false
MICROSERVICE_VISUALIZE_SOL2UML_ENABLED=false
MICROSERVICE_SIG_PROVIDER_ENABLED=false
MICROSERVICE_METADATA_ENABLED=false
SOURCIFY_INTEGRATION_ENABLED=false
ACCOUNT_ENABLED=false

# Self-hosted explorer: our own nginx already rate-limits the public edge, and
# Blockscout responding 429 makes its frontend throw "reCAPTCHA V2 site key is
# not set" — an unhandled exception that blanks every page with a client-side
# error. We serve no reCAPTCHA (it would be an external dependency), so the
# limiter must be off. This bites hardest on a fast chain, where the frontend
# polls often enough to trip the default limit within seconds.
# The per-client limit is enforced one layer up instead, in the edge nginx
# (infra/compose/nginx/nginx.conf, explorer.ferminux.net: zones "explorer" and
# "explorer_rpc"). Do not remove both.
API_RATE_LIMIT_DISABLED=true
DISABLE_API_RATE_LIMIT=true
API_RATE_LIMIT=1000
API_RATE_LIMIT_TIME_INTERVAL=1s
API_RATE_LIMIT_BY_IP=1000
API_RATE_LIMIT_HAMMER_TIME_INTERVAL=1s
ACCOUNT_ENABLED=false
