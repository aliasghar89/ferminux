# Blockscout backend — Ferminux Network (static config)
# RPC URLs, DATABASE_URL and SECRET_KEY_BASE are injected by docker-compose.yml / k8s.

# --- chain identity ---
CHAIN_ID=3961
COIN=FMX
COIN_NAME=FMX
NETWORK=Ferminux
SUBNETWORK=Ferminux Network
CHAIN_TYPE=default

# --- node ---
ETHEREUM_JSONRPC_VARIANT=geth
ETHEREUM_JSONRPC_TRANSPORT=http
# ferminux-geth (geth v1.10.26 fork): the public RPC does not expose debug/trace,
# so internal transactions and trace-based fetchers are off.
INDEXER_DISABLE_INTERNAL_TRANSACTIONS_FETCHER=true
# geth variant cannot fetch beneficiaries; the rewards sidecar covers miner rewards.
INDEXER_DISABLE_BLOCK_REWARD_FETCHER=true

# Imports the genesis premine balances (geth-format spec, alloc section).
CHAIN_SPEC_PATH=/app/chainspec/genesis.json

# --- server ---
PORT=4000
ECTO_USE_SSL=false
POOL_SIZE=30
POOL_SIZE_API=10
API_V2_ENABLED=true
NETWORK_PATH=/
DISABLE_INDEXER=false
DISABLE_REALTIME_INDEXER=false

# --- EIP-1559 (enabled from genesis, elasticity 2, initial base fee 1 gwei) ---
EIP_1559_ELASTICITY_MULTIPLIER=2

# --- self-hosted: no external services, no telemetry ---
DISABLE_EXCHANGE_RATES=true
MICROSERVICE_SC_VERIFIER_ENABLED=false
MICROSERVICE_ETH_BYTECODE_DB_ENABLED=false
MICROSERVICE_VISUALIZE_SOL2UML_ENABLED=false
MICROSERVICE_SIG_PROVIDER_ENABLED=false
MICROSERVICE_METADATA_ENABLED=false
SOURCIFY_INTEGRATION_ENABLED=false
ACCOUNT_ENABLED=false

# Self-hosted explorer: our own nginx already rate-limits the public edge, and
# Blockscout responding 429 makes its frontend throw "reCAPTCHA V2 site key is
# not set" — an unhandled exception that blanks every page with a client-side
# error. We serve no reCAPTCHA (it would be an external dependency), so the
# limiter must be off. This bites hardest on a fast chain, where the frontend
# polls often enough to trip the default limit within seconds.
API_RATE_LIMIT_DISABLED=true
DISABLE_API_RATE_LIMIT=true
API_RATE_LIMIT=1000
API_RATE_LIMIT_TIME_INTERVAL=1s
API_RATE_LIMIT_BY_IP=1000
API_RATE_LIMIT_HAMMER_TIME_INTERVAL=1s
ACCOUNT_ENABLED=false
